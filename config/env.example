# AETHER AI Workstation - Configuration Template

# Azure Foundry (Primary)
ANTHROPIC_FOUNDRY_API_KEY=your-key-here
ANTHROPIC_FOUNDRY_URI=https://your-resource.services.ai.azure.com/anthropic/v1/messages

# NVIDIA NIM
NVIDIA_API_KEY=your-key-here

# OpenRouter
OPENROUTER_KEY=your-key-here

# Local AI (Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Optional: Other providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
